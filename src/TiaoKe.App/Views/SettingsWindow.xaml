<Window x:Class="TiaoKe.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="眺刻设置"
        Width="700"
        Height="520"
        MinWidth="620"
        MinHeight="460"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Padding="24,20,24,14" Background="{StaticResource PageBackgroundBrush}">
            <StackPanel>
                <TextBlock FontSize="20" FontWeight="Medium" Text="眺刻设置" />
                <TextBlock Margin="0,6,0,0"
                           FontSize="13"
                           Foreground="{StaticResource MutedTextBrush}"
                           Text="调整工作与远眺节奏" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1"
                Margin="24,0"
                Padding="24"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="#DFE4E1"
                BorderThickness="1"
                CornerRadius="8">
            <StackPanel>
                <TextBlock FontSize="16" FontWeight="Medium" Text="工作与休息" />

                <Grid Margin="0,22,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="160" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="工作时长" />
                        <TextBlock Margin="0,4,0,0" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Text="到点后提醒会保持显示" />
                    </StackPanel>
                    <DockPanel Grid.Column="1">
                        <TextBlock DockPanel.Dock="Right" Margin="8,0,0,0" VerticalAlignment="Center" Text="分钟" />
                        <TextBox x:Name="WorkMinutesTextBox" Padding="8" VerticalContentAlignment="Center" />
                    </DockPanel>
                </Grid>

                <Separator Margin="0,16" Background="#EDF0EE" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="160" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="休息时长" />
                        <TextBlock Margin="0,4,0,0" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Text="休息结束后开始新一轮" />
                    </StackPanel>
                    <DockPanel Grid.Column="1">
                        <TextBlock DockPanel.Dock="Right" Margin="8,0,0,0" VerticalAlignment="Center" Text="秒" />
                        <TextBox x:Name="RestSecondsTextBox" Padding="8" VerticalContentAlignment="Center" />
                    </DockPanel>
                </Grid>

                <Separator Margin="0,16" Background="#EDF0EE" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="现在需要离开屏幕？" />
                        <TextBlock Margin="0,4,0,0" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Text="不用等待当前工作计时结束" />
                    </StackPanel>
                    <Button Grid.Column="1" MinWidth="100" Click="RestNow_Click" Content="立即休息" />
                </Grid>

                <Separator Margin="0,16" Background="#EDF0EE" />

                <CheckBox x:Name="LaunchAtLoginCheckBox"
                          VerticalContentAlignment="Center"
                          Content="登录 Windows 后自动启动" />

                <TextBlock x:Name="ValidationText"
                           Margin="0,18,0,0"
                           Foreground="#B7473E"
                           Visibility="Collapsed" />
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Padding="24,14" BorderBrush="#DFE4E1" BorderThickness="0,1,0,0">
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button Margin="0,0,8,0" Click="Cancel_Click" Content="取消" />
                <Button MinWidth="100"
                        Background="{StaticResource BrandBrush}"
                        Foreground="White"
                        Click="Save_Click"
                        Content="保存更改" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
