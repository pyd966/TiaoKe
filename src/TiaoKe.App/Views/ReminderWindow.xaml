<Window x:Class="TiaoKe.App.Views.ReminderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="眺刻休息提醒"
        Width="360"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent">
    <Border Margin="12"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="7" Opacity="0.18" Color="#202522" />
        </Border.Effect>
        <Grid ClipToBounds="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0"
                    Background="{DynamicResource WarningBrush}"
                    CornerRadius="8,0,0,8" />

            <Grid Grid.Column="1" Margin="18,14,16,14">
                <Grid x:Name="ReminderPanel">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Top">
                            <TextBlock FontSize="18"
                                       FontWeight="Medium"
                                       Text="该看看远处了" />
                            <TextBlock x:Name="WorkSummaryText"
                                       Margin="0,5,8,0"
                                       FontSize="13"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       Text="这一轮已经专注 20 分钟" />
                        </StackPanel>
                        <Button x:Name="MoreButton"
                                Grid.Column="1"
                                Margin="8,-5,-6,0"
                                VerticalAlignment="Top"
                                Style="{StaticResource GhostButtonStyle}"
                                Click="More_Click"
                                ToolTip="更多操作"
                                Content="···">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="重置本轮计时" Click="Reset_Click" />
                                    <MenuItem Header="暂停休息提醒">
                                        <MenuItem Header="15 分钟" Click="Pause15_Click" />
                                        <MenuItem Header="30 分钟" Click="Pause30_Click" />
                                        <MenuItem Header="1 小时" Click="Pause60_Click" />
                                        <MenuItem Header="2 小时" Click="Pause120_Click" />
                                        <MenuItem Header="今天不再提醒" Click="PauseToday_Click" />
                                    </MenuItem>
                                    <Separator />
                                    <MenuItem Header="打开设置…" Click="OpenSettings_Click" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </Grid>
                    <Button Grid.Row="1"
                            Width="112"
                            Margin="0,18,0,0"
                            HorizontalAlignment="Right"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="StartRest_Click">
                        <TextBlock Foreground="{DynamicResource BrandForegroundBrush}"
                                   Text="开始远眺"
                                   TextWrapping="NoWrap" />
                    </Button>
                </Grid>

                <Grid x:Name="RestPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock FontSize="18"
                                   FontWeight="Medium"
                                   Text="看向 6 米以外" />
                        <TextBlock x:Name="RestHintText"
                                   Margin="0,5,0,0"
                                   FontSize="13"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Text="放松眼睛，慢慢眨眼" />
                    </StackPanel>
                    <Grid Grid.Row="1" Margin="0,17,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="RestTimeText"
                                   VerticalAlignment="Center"
                                   FontSize="26"
                                   FontWeight="Medium"
                                   Text="00:20" />
                        <ProgressBar x:Name="RestProgress"
                                     Grid.Column="1"
                                     Height="6"
                                     Margin="14,0"
                                     VerticalAlignment="Center"
                                     BorderThickness="0"
                                     Foreground="{DynamicResource BrandBrush}"
                                     Background="{DynamicResource DividerBrush}"
                                     Maximum="20"
                                     Value="20" />
                        <Button Grid.Column="2"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="EndRest_Click"
                                Content="提前结束" />
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
