<Window x:Class="TiaoKe.App.Views.ReminderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="眺刻休息提醒"
        Width="360"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent">
    <Border Margin="12"
            Padding="0"
            Background="{StaticResource SurfaceBrush}"
            BorderBrush="#DFE4E1"
            BorderThickness="1"
            CornerRadius="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="7" Opacity="0.18" Color="#202522" />
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{StaticResource WarningBrush}" CornerRadius="8,0,0,8" />
            <Grid Grid.Column="1" Margin="18,16,16,16">
                <Grid x:Name="ReminderPanel">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock FontSize="18" FontWeight="Medium" Text="该看看远处了" />
                        <TextBlock x:Name="WorkSummaryText"
                                   Margin="0,5,0,0"
                                   FontSize="14"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Text="这一轮已经专注 20 分钟" />
                    </StackPanel>
                    <Button Grid.Row="1"
                            Margin="0,22,0,0"
                            HorizontalAlignment="Right"
                            MinWidth="112"
                            Background="{StaticResource BrandBrush}"
                            Foreground="White"
                            Click="StartRest_Click"
                            Content="开始远眺" />
                </Grid>

                <Grid x:Name="RestPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock FontSize="18" FontWeight="Medium" Text="看向 6 米以外" />
                        <TextBlock Margin="0,5,0,0"
                                   FontSize="14"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Text="放松眼睛，慢慢眨眼" />
                    </StackPanel>
                    <Grid Grid.Row="1" Margin="0,17,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="RestTimeText"
                                   VerticalAlignment="Center"
                                   FontSize="22"
                                   FontWeight="Medium"
                                   Text="00:20" />
                        <ProgressBar x:Name="RestProgress"
                                     Grid.Column="1"
                                     Height="6"
                                     Margin="14,0,0,0"
                                     VerticalAlignment="Center"
                                     BorderThickness="0"
                                     Foreground="{StaticResource BrandBrush}"
                                     Maximum="20"
                                     Value="20" />
                    </Grid>
                    <StackPanel Grid.Row="2" Margin="0,14,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button Click="EndRest_Click" Content="提前结束" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
