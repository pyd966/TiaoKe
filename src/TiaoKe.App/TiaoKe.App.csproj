<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>TiaoKe</AssemblyName>
    <RootNamespace>TiaoKe.App</RootNamespace>
    <Version>0.1.2</Version>
    <AssemblyVersion>0.1.2.0</AssemblyVersion>
    <FileVersion>0.1.2.0</FileVersion>
    <InformationalVersion>0.1.2</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <AssemblyTitle>眺刻 TiaoKe</AssemblyTitle>
    <Product>眺刻 TiaoKe</Product>
    <Description>安静、不打断的 Windows 远眺休息提醒工具</Description>
    <Authors>pyd966</Authors>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\tiaoke.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="Assets\tiaoke-icon.png" />
    <None Remove="Assets\tiaoke.ico" />
    <None Remove="Assets\tiaoke-reminder.wav" />
    <None Remove="Assets\tiaoke-rest-complete.wav" />
    <Resource Include="Assets\tiaoke-icon.png" />
    <Resource Include="Assets\tiaoke.ico" />
    <Resource Include="Assets\tiaoke-reminder.wav" />
    <Resource Include="Assets\tiaoke-rest-complete.wav" />
  </ItemGroup>
</Project>
